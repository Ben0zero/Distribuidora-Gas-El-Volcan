# ==============================================================================
#  PLANTILLA de variables para docker-compose.yml (El Volcán)
# ------------------------------------------------------------------------------
#  1. Copia este archivo a ".env" en la raíz del repositorio (junto a docker-compose.yml).
#  2. Reemplaza los valores de ejemplo por los reales.
#  3. NUNCA subas .env al repositorio (está en .gitignore).
#
#  Estas variables tienen prioridad sobre ~/.elvolcan/secrets.properties, que
#  dentro de los contenedores no existe (ese archivo es para correr sin Docker).
#  Guía completa: docs/DOCKER.md
# ==============================================================================

# --- Wallet de Oracle Cloud ---
# Carpeta del Wallet descomprimido EN ESTA MÁQUINA. Se monta en /wallet (solo lectura).
#   Windows (Docker Desktop):  C:/Users/<usuario>/.elvolcan/OracleWallet   (usa /)
#   Linux / EC2:               /home/ubuntu/elvolcan-secretos/OracleWallet
WALLET_HOST_DIR=C:/Users/<usuario>/.elvolcan/OracleWallet

# --- Base de datos Oracle Cloud ---
DB_USER=ADMIN
DB_PASSWORD=cambia_esta_contrasena

# --- JWT ---
# Mínimo 32 caracteres. Es la MISMA para los 4 microservicios (se pasa a todos).
JWT_SECRET=reemplazar_por_una_clave_larga_de_al_menos_32_caracteres

# --- Memoria de la JVM (por contenedor) ---
# 4 microservicios con -Xmx384m + Eureka con -Xmx256m caben en una máquina de 4 GB.
JAVA_OPTS=-Xmx384m
EUREKA_JAVA_OPTS=-Xmx256m

# --- Frontend ---
# URL con la que se abre el sitio; se usa en los enlaces de recuperación de contraseña.
#   Local:  http://localhost
#   EC2:    http://<IP-publica-de-EC2>
APP_FRONTEND_URL=http://localhost

# --- Semilla de datos (catálogo e inventario) ---
# true borra y vuelve a cargar los 14 productos al iniciar. Usar una sola vez y volver a false.
REINICIAR_SEMILLA=false

# --- Recuperación de contraseña ---
# log    = el enlace solo se escribe en el log de ms-auth (docker compose logs ms-auth)
# correo = se envía por SMTP con los datos de abajo
NOTIFICACION_MODO=log

# (Opcional) SMTP para NOTIFICACION_MODO=correo. Equivalen a spring.mail.* de secrets.properties.
# Gmail: usa una "contraseña de aplicación" (https://myaccount.google.com/apppasswords),
# no tu contraseña normal; pega los 16 caracteres sin espacios.
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=tu_cuenta@gmail.com
# SPRING_MAIL_PASSWORD=contrasena_de_aplicacion_de_16_caracteres
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# (Opcional) Remitente que verá el usuario; por defecto es SPRING_MAIL_USERNAME
# APP_NOTIFICACION_REMITENTE=tu_cuenta@gmail.com
